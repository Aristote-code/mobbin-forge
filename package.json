{
  "name": "mobbin-forge",
  "version": "1.7.0",
  "description": "MCP server for searching and browsing Mobbin design inspiration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mobbin-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "scripts/download-openmobile-pilot.mjs"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc && node scripts/build-ui.mjs",
    "test": "npm run build && tsx --test test/*.test.ts",
    "start": "tsx src/index.ts",
    "dev": "tsx --watch src/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepublishOnly": "npm run build",
    "test:live": "npm run build && tsx test/live-mcp-smoke.ts",
    "preview:gallery": "npm run build && node scripts/preview-gallery.mjs",
    "pilot:download": "node scripts/download-openmobile-pilot.mjs",
    "test:library:offline": "npm run build && node scripts/verify-local-library.mjs",
    "benchmark:library": "npm run build && node scripts/benchmark-local-library.mjs",
    "test:library:comparison": "npm run build && node scripts/verify-local-comparison.mjs",
    "test:library:diversity": "npm run build && node scripts/verify-local-diversity.mjs",
    "knowledge:pilot": "npm run build && node scripts/seed-ui-knowledge.mjs"
  },
  "keywords": [
    "mcp",
    "mobbin",
    "design"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aristote-code/mobbin-forge.git"
  },
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.2"
  }
}
